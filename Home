<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Digital welcome guide for our apartment in Turin."
    >

    <title>Welcome to Our Apartment</title>

    <style>
        /* =========================================================
           1. GLOBAL SETTINGS
        ========================================================= */

        :root {
            --primary: #16324f;
            --primary-light: #24557d;
            --accent: #d99f59;
            --accent-light: #f2c98e;
            --background: #f6f3ee;
            --surface: #ffffff;
            --surface-soft: #faf8f4;
            --text: #26313a;
            --text-light: #66717a;
            --success: #2f7d61;
            --danger: #c65353;
            --border: rgba(22, 50, 79, 0.12);
            --shadow: 0 16px 40px rgba(31, 42, 55, 0.10);
            --shadow-small: 0 8px 22px rgba(31, 42, 55, 0.08);
            --radius: 22px;
            --radius-small: 14px;
            --container: 1180px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 110px;
        }

        body {
            min-height: 100vh;
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
            color: var(--text);
            background: var(--background);
            line-height: 1.6;
        }

        body.menu-open {
            overflow: hidden;
        }

        img {
            display: block;
            max-width: 100%;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input {
            font: inherit;
        }

        button {
            border: 0;
        }

        ul {
            list-style: none;
        }

        section {
            padding: 88px 24px;
        }

        .container {
            width: min(100%, var(--container));
            margin-inline: auto;
        }

        .section-heading {
            max-width: 700px;
            margin-bottom: 38px;
        }

        .section-label {
            display: inline-block;
            margin-bottom: 10px;
            color: var(--accent);
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .section-heading h2 {
            color: var(--primary);
            font-size: clamp(2rem, 5vw, 3.3rem);
            line-height: 1.1;
            letter-spacing: -0.04em;
        }

        .section-heading p {
            max-width: 650px;
            margin-top: 15px;
            color: var(--text-light);
            font-size: 1.05rem;
        }

        /* =========================================================
           2. NAVIGATION
        ========================================================= */

        .navbar {
            position: fixed;
            z-index: 1000;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(255, 255, 255, 0.92);
            border-bottom: 1px solid var(--border);
            box-shadow: 0 5px 20px rgba(30, 45, 60, 0.05);
            backdrop-filter: blur(18px);
        }

        .nav-inner {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 76px;
            gap: 20px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--primary);
            font-weight: 800;
        }

        .brand-icon {
            display: grid;
            width: 43px;
            height: 43px;
            place-items: center;
            color: white;
            background: var(--primary);
            border-radius: 50%;
            font-size: 1.25rem;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .nav-links a {
            position: relative;
            color: var(--text-light);
            font-size: 0.95rem;
            font-weight: 700;
        }

        .nav-links a::after {
            position: absolute;
            right: 0;
            bottom: -7px;
            left: 0;
            height: 2px;
            content: "";
            background: var(--accent);
            transform: scaleX(0);
            transition: transform 0.25s ease;
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .nav-links a:hover::after {
            transform: scaleX(1);
        }

        .menu-button {
            display: none;
            width: 44px;
            height: 44px;
            color: var(--primary);
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 12px;
            cursor: pointer;
            font-size: 1.35rem;
        }

        /* =========================================================
           3. LANGUAGE SELECTOR
        ========================================================= */

        .language-bar {
            position: relative;
            z-index: 10;
            padding: 12px 20px;
            background: var(--primary);
        }

        .language-list {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            flex-wrap: wrap;
        }

        .language-button {
            display: flex;
            align-items: center;
            gap: 7px;
            min-height: 38px;
            padding: 5px 11px;
            color: rgba(255, 255, 255, 0.82);
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 999px;
            cursor: pointer;
            transition:
                transform 0.2s ease,
                background 0.2s ease,
                color 0.2s ease;
        }

        .language-button:hover {
            color: white;
            background: rgba(255, 255, 255, 0.16);
            transform: translateY(-2px);
        }

        .language-button.active {
            color: var(--primary);
            background: white;
        }

        .flag {
            font-size: 1.35rem;
            line-height: 1;
        }

        .language-name {
            font-size: 0.78rem;
            font-weight: 800;
        }

        /* =========================================================
           4. HERO
        ========================================================= */

        .hero {
            position: relative;
            display: grid;
            min-height: 100vh;
            padding: 155px 24px 70px;
            place-items: center;
            overflow: hidden;
            color: white;
            background:
                linear-gradient(
                    90deg,
                    rgba(10, 29, 46, 0.92) 0%,
                    rgba(10, 29, 46, 0.76) 43%,
                    rgba(10, 29, 46, 0.30) 100%
                ),
                 url("https://drive.google.com/thumbnail?id=1JMEyr-s7wVvKA9i7febR1yLvqgs-dAmL&sz=w1600");
                center / cover no-repeat;
        }

        .hero::after {
            position: absolute;
            inset: auto 0 0;
            height: 150px;
            content: "";
            background: linear-gradient(transparent, var(--background));
        }

        .hero-content {
            position: relative;
            z-index: 2;
            width: min(100%, var(--container));
        }

        .hero-text {
            max-width: 760px;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 22px;
            padding: 8px 14px;
            color: var(--accent-light);
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.20);
            border-radius: 999px;
            backdrop-filter: blur(10px);
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .hero h1 {
            max-width: 820px;
            font-size: clamp(3rem, 8vw, 6.6rem);
            line-height: 0.96;
            letter-spacing: -0.055em;
        }

        .hero-description {
            max-width: 670px;
            margin-top: 25px;
            color: rgba(255, 255, 255, 0.88);
            font-size: clamp(1.05rem, 2vw, 1.28rem);
        }

        .hero-actions {
            display: flex;
            margin-top: 34px;
            gap: 13px;
            flex-wrap: wrap;
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 51px;
            padding: 12px 22px;
            border-radius: 999px;
            cursor: pointer;
            font-weight: 800;
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                background 0.2s ease;
        }

        .button:hover {
            transform: translateY(-3px);
        }

        .button-primary {
            color: var(--primary);
            background: var(--accent-light);
            box-shadow: 0 10px 30px rgba(217, 159, 89, 0.25);
        }

        .button-secondary {
            color: white;
            background: rgba(255, 255, 255, 0.09);
            border: 1px solid rgba(255, 255, 255, 0.28);
            backdrop-filter: blur(8px);
        }

        .quick-facts {
            display: flex;
            margin-top: 48px;
            gap: 12px;
            flex-wrap: wrap;
        }

        .quick-fact {
            min-width: 135px;
            padding: 16px 18px;
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: var(--radius-small);
            backdrop-filter: blur(12px);
        }

        .quick-fact strong {
            display: block;
            font-size: 1.05rem;
        }

        .quick-fact span {
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.82rem;
        }

        /* =========================================================
           5. WELCOME AND AMENITIES
        ========================================================= */

        .welcome-grid {
            display: grid;
            align-items: center;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        .welcome-image {
            position: relative;
        }

        .welcome-image img {
            width: 100%;
            height: 540px;
            object-fit: cover;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .image-badge {
            position: absolute;
            right: -20px;
            bottom: 28px;
            max-width: 230px;
            padding: 18px 20px;
            color: white;
            background: var(--primary);
            border-radius: var(--radius-small);
            box-shadow: var(--shadow);
        }

        .image-badge strong {
            display: block;
            color: var(--accent-light);
            font-size: 1.1rem;
        }

        .welcome-copy h2 {
            color: var(--primary);
            font-size: clamp(2.25rem, 5vw, 4rem);
            line-height: 1.06;
            letter-spacing: -0.045em;
        }

        .welcome-copy p {
            margin-top: 20px;
            color: var(--text-light);
            font-size: 1.08rem;
        }

        .check-list {
            display: grid;
            margin-top: 28px;
            gap: 14px;
        }

        .check-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-weight: 700;
        }

        .check-icon {
            display: grid;
            flex: 0 0 27px;
            width: 27px;
            height: 27px;
            place-items: center;
            color: white;
            background: var(--success);
            border-radius: 50%;
            font-size: 0.8rem;
        }

        .amenities-section {
            background: var(--surface);
        }

        .amenities-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 17px;
        }

        .amenity-card {
            min-height: 180px;
            padding: 24px;
            background: var(--surface-soft);
            border: 1px solid var(--border);
            border-radius: var(--radius-small);
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                border-color 0.25s ease;
        }

        .amenity-card:hover {
            border-color: rgba(217, 159, 89, 0.55);
            box-shadow: var(--shadow-small);
            transform: translateY(-6px);
        }

        .amenity-icon {
            display: grid;
            width: 50px;
            height: 50px;
            margin-bottom: 17px;
            place-items: center;
            color: var(--primary);
            background: #efe4d4;
            border-radius: 15px;
            font-size: 1.45rem;
        }

        .amenity-card h3 {
            margin-bottom: 6px;
            color: var(--primary);
            font-size: 1rem;
        }

        .amenity-card p {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        /* =========================================================
           6. INFORMATION CARDS
        ========================================================= */

        .information-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
        }

        .info-card {
            padding: 30px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-small);
        }

        .info-card.full-width {
            grid-column: 1 / -1;
        }

        .info-card-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 22px;
        }

        .info-card-icon {
            display: grid;
            flex: 0 0 52px;
            width: 52px;
            height: 52px;
            place-items: center;
            color: white;
            background: var(--primary);
            border-radius: 16px;
            font-size: 1.45rem;
        }

        .info-card h3 {
            color: var(--primary);
            font-size: 1.3rem;
        }

        .info-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 0;
            gap: 20px;
            border-bottom: 1px solid var(--border);
        }

        .info-row:last-child {
            border-bottom: 0;
        }

        .info-row span:first-child {
            color: var(--text-light);
        }

        .info-row strong {
            color: var(--primary);
            text-align: right;
            overflow-wrap: anywhere;
        }

        .copy-button {
            margin-left: 8px;
            padding: 6px 10px;
            color: white;
            background: var(--primary-light);
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.75rem;
            font-weight: 800;
        }

        .rules-list {
            display: grid;
            gap: 13px;
        }

        .rules-list li {
            display: flex;
            gap: 13px;
            padding: 13px 15px;
            background: var(--surface-soft);
            border-radius: 12px;
        }

        .rule-number {
            color: var(--accent);
            font-weight: 900;
        }

        .nearby-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .nearby-item {
            padding: 21px;
            background: var(--surface-soft);
            border: 1px solid var(--border);
            border-radius: var(--radius-small);
        }

        .nearby-item span {
            display: block;
            margin-bottom: 8px;
            font-size: 1.65rem;
        }

        .nearby-item h4 {
            color: var(--primary);
        }

        .nearby-item p {
            margin-top: 4px;
            color: var(--text-light);
            font-size: 0.9rem;
        }

        /* =========================================================
           7. CONTACT AND FOOTER
        ========================================================= */

        .contact-section {
            color: white;
            background: var(--primary);
        }

        .contact-section .section-label {
            color: var(--accent-light);
        }

        .contact-section .section-heading h2,
        .contact-section .section-heading p {
            color: white;
        }

        .contact-section .section-heading p {
            opacity: 0.76;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 24px;
        }

        .contact-card {
            padding: 32px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: var(--radius);
        }

        .contact-card h3 {
            color: var(--accent-light);
            font-size: 1.35rem;
        }

        .contact-card p {
            margin-top: 8px;
            color: rgba(255, 255, 255, 0.76);
        }

        .contact-links {
            display: grid;
            margin-top: 23px;
            gap: 12px;
        }

        .contact-link {
            display: flex;
            align-items: center;
            padding: 14px 16px;
            gap: 12px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            overflow-wrap: anywhere;
        }

        .contact-link:hover {
            background: rgba(255, 255, 255, 0.14);
        }

        .emergency-item {
            padding: 16px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.14);
        }

        .emergency-item:last-child {
            border-bottom: 0;
        }

        .emergency-item strong {
            display: block;
            color: var(--accent-light);
            font-size: 1.2rem;
        }

        footer {
            padding: 28px 24px;
            color: rgba(255, 255, 255, 0.68);
            background: #0b1d2d;
            text-align: center;
            font-size: 0.9rem;
        }

        /* Toast notification */

        .toast {
            position: fixed;
            z-index: 2000;
            right: 20px;
            bottom: 20px;
            max-width: calc(100% - 40px);
            padding: 13px 18px;
            color: white;
            background: var(--success);
            border-radius: 12px;
            box-shadow: var(--shadow);
            opacity: 0;
            pointer-events: none;
            transform: translateY(20px);
            transition:
                opacity 0.3s ease,
                transform 0.3s ease;
        }

        .toast.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* =========================================================
           8. RESPONSIVE DESIGN
        ========================================================= */

        @media (max-width: 980px) {
            .nav-links {
                position: absolute;
                top: calc(100% + 1px);
                right: 0;
                left: 0;
                display: none;
                padding: 22px 24px 28px;
                background: white;
                border-bottom: 1px solid var(--border);
                box-shadow: var(--shadow-small);
                flex-direction: column;
                align-items: flex-start;
                gap: 20px;
            }

            .nav-links.open {
                display: flex;
            }

            .menu-button {
                display: grid;
                place-items: center;
            }

            .welcome-grid,
            .contact-grid {
                grid-template-columns: 1fr;
            }

            .welcome-image {
                max-width: 720px;
            }

            .amenities-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 760px) {
            section {
                padding: 68px 18px;
            }

            .hero {
                min-height: auto;
                padding: 175px 18px 100px;
                background-position: 62% center;
            }

            .hero h1 {
                font-size: clamp(3rem, 14vw, 4.8rem);
            }

            .language-name {
                display: none;
            }

            .language-button {
                width: 42px;
                height: 38px;
                padding: 4px;
                justify-content: center;
            }

            .quick-facts {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
            }

            .quick-fact {
                min-width: 0;
            }

            .welcome-image img {
                height: 390px;
            }

            .image-badge {
                right: 12px;
                bottom: 12px;
                left: 12px;
                max-width: none;
            }

            .amenities-grid,
            .information-grid,
            .nearby-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .info-card.full-width {
                grid-column: auto;
            }

            .nearby-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 520px) {
            .brand-text {
                font-size: 0.9rem;
            }

            .hero-actions {
                display: grid;
            }

            .button {
                width: 100%;
            }

            .amenities-grid,
            .information-grid {
                grid-template-columns: 1fr;
            }

            .info-card {
                padding: 23px;
            }

            .info-row {
                align-items: flex-start;
                flex-direction: column;
                gap: 4px;
            }

            .info-row strong {
                text-align: left;
            }

            .contact-card {
                padding: 24px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar" aria-label="Primary navigation">
        <div class="container nav-inner">
            #home
                <span class="brand-icon" aria-hidden="true">⌂</span>
                <span class="brand-text" data-i18n="brand">
                    Turin Guest House
                </span>
            </a>

            <div class="nav-links" id="navLinks">
                #welcomeWelcome</a>
                #amenitiesAmenities</a>
                #informationGuest guide</a>
                #contactContact</a>
            </div>

            <button
                class="menu-button"
                id="menuButton"
                type="button"
                aria-label="Open navigation menu"
                aria-expanded="false"
            >
                ☰
            </button>
        </div>

        <!-- Country flags -->
        <div class="language-bar">
            <div class="language-list" aria-label="Select language">

                <button class="language-button" data-language="en" type="button">
                    <span class="flag" aria-hidden="true">🇬🇧</span>
                    <span class="language-name">English</span>
                </button>

                <button class="language-button" data-language="it" type="button">
                    <span class="flag" aria-hidden="true">🇮🇹</span>
                    <span class="language-name">Italiano</span>
                </button>

                <button class="language-button" data-language="fr" type="button">
                    <span class="flag" aria-hidden="true">🇫🇷</span>
                    <span class="language-name">Français</span>
                </button>

                <button class="language-button" data-language="de" type="button">
                    <span class="flag" aria-hidden="true">🇩🇪</span>
                    <span class="language-name">Deutsch</span>
                </button>

                <button class="language-button" data-language="es" type="button">
                    <span class="flag" aria-hidden="true">🇪🇸</span>
                    <span class="language-name">Español</span>
                </button>

                <button class="language-button" data-language="pt" type="button">
                    <span class="flag" aria-hidden="true">🇵🇹</span>
                    <span class="language-name">Português</span>
                </button>

                <button class="language-button" data-language="zh" type="button">
                    <span class="flag" aria-hidden="true">🇨🇳</span>
                    <span class="language-name">中文</span>
                </button>

            </div>
        </div>
    </nav>

    <main>

        <!-- Hero -->
        <section class="hero" id="home">
            <div class="hero-content">
                <div class="hero-text">

                    <div class="hero-tag">
                        <span aria-hidden="true">✦</span>
                        <span data-i18n="heroTag">Your home in Turin</span>
                    </div>

                    <h1 data-i18n="heroTitle">
                        Welcome to our apartment
                    </h1>

                    <p class="hero-description" data-i18n="heroText">
                        We are delighted to welcome you. This digital guide
                        contains everything you need for a comfortable and
                        enjoyable stay.
                    </p>

                    <div class="hero-actions">
                        #information
                            Open guest guide
                        </a>

                        #contact
                            Contact your host
                        </a>
                    </div>

                    <div class="quick-facts">
                        <div class="quick-fact">
                            <strong>2</strong>
